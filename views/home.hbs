{{#if removedUser}}
<div class="alert alert-success alert-dismissible fade show" role="alert">
  <i class="bi bi-check-circle-fill me-2"></i>
  Participant has been successfully removed from the system.
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
{{/if}}

<!-- Page Header -->
<div class="page-header">
  <div class="row align-items-center">
    <div class="col-md-8">
      <h1><i class="bi bi-people-fill me-3"></i>Participant Management</h1>
      <p class="mb-0">Manage participants in your AWS First Cloud Journey program</p>
    </div>
    <div class="col-md-4 text-md-end">
      <a href="/adduser" class="btn btn-success btn-lg">
        <i class="bi bi-person-plus me-2"></i>Add Participant
      </a>
    </div>
  </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
  <div class="col-md-3">
    <div class="card text-center">
      <div class="card-body">
        <i class="bi bi-people display-4 text-primary mb-3"></i>
        <h3 class="card-title">{{rows.length}}</h3>
        <p class="card-text text-muted">Total Participants</p>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card text-center">
      <div class="card-body">
        <i class="bi bi-check-circle display-4 text-success mb-3"></i>
        <h3 class="card-title">{{rows.length}}</h3>
        <p class="card-text text-muted">Active</p>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card text-center">
      <div class="card-body">
        <i class="bi bi-calendar-event display-4 text-info mb-3"></i>
        <h3 class="card-title">{{rows.length}}</h3>
        <p class="card-text text-muted">This Month</p>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card text-center">
      <div class="card-body">
        <i class="bi bi-trophy display-4 text-warning mb-3"></i>
        <h3 class="card-title">0</h3>
        <p class="card-text text-muted">Completed</p>
      </div>
    </div>
  </div>
</div>

<!-- Participants Table -->
<div class="card">
  <div class="card-header">
    <div class="row align-items-center">
      <div class="col">
        <h5 class="mb-0">
          <i class="bi bi-table me-2"></i>All Participants
          <span class="badge bg-light text-dark ms-2">{{rows.length}}</span>
        </h5>
      </div>
      <div class="col-auto">
        <div class="btn-group" role="group">
          <button type="button" class="btn btn-outline-light btn-sm active">
            <i class="bi bi-table"></i> Table
          </button>
          <button type="button" class="btn btn-outline-light btn-sm">
            <i class="bi bi-grid-3x3-gap"></i> Grid
          </button>
        </div>
      </div>
    </div>
  </div>
  
  <div class="card-body p-0">
    {{#if rows}}
    <div class="table-container">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th scope="col">
              <i class="bi bi-hash me-1"></i>ID
            </th>
            <th scope="col">
              <i class="bi bi-person me-1"></i>Name
            </th>
            <th scope="col">
              <i class="bi bi-envelope me-1"></i>Email
            </th>
            <th scope="col">
              <i class="bi bi-telephone me-1"></i>Phone
            </th>
            <th scope="col">
              <i class="bi bi-circle-fill me-1"></i>Status
            </th>
            <th scope="col" class="text-end">
              <i class="bi bi-gear me-1"></i>Actions
            </th>
          </tr>
        </thead>
        <tbody>
          {{#each rows}}
          <tr>
            <td>
              <span class="badge bg-primary">#{{this.id}}</span>
            </td>
            <td>
              <div class="d-flex align-items-center">
                <div class="avatar-circle me-3">
                  <i class="bi bi-person-fill"></i>
                </div>
                <div>
                  <div class="fw-bold">{{this.first_name}} {{this.last_name}}</div>
                  <small class="text-muted">Participant</small>
                </div>
              </div>
            </td>
            <td>
              <a href="mailto:{{this.email}}" class="text-decoration-none">
                <i class="bi bi-envelope me-1"></i>{{this.email}}
              </a>
            </td>
            <td>
              <a href="tel:{{this.phone}}" class="text-decoration-none">
                <i class="bi bi-telephone me-1"></i>{{this.phone}}
              </a>
            </td>
            <td>
              <span class="badge status-active">
                <i class="bi bi-check-circle me-1"></i>Active
              </span>
            </td>
            <td>
              <div class="action-buttons">
                <a href="/viewuser/{{this.id}}" class="btn btn-info btn-sm" title="View Details">
                  <i class="bi bi-eye-fill"></i>
                </a>
                <a href="/edituser/{{this.id}}" class="btn btn-primary btn-sm" title="Edit">
                  <i class="bi bi-pencil-fill"></i>
                </a>
                <a href="/{{this.id}}" class="btn btn-danger btn-sm btn-delete" title="Delete">
                  <i class="bi bi-trash-fill"></i>
                </a>
              </div>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{else}}
    <!-- Empty State -->
    <div class="text-center py-5">
      <i class="bi bi-inbox display-1 text-muted mb-4"></i>
      <h4 class="text-muted">No participants yet</h4>
      <p class="text-muted mb-4">Get started by adding your first participant to the program.</p>
      <a href="/adduser" class="btn btn-primary btn-lg">
        <i class="bi bi-person-plus me-2"></i>Add First Participant
      </a>
    </div>
    {{/if}}
  </div>
</div>

<style>
.avatar-circle {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-weight: bold;
  font-size: 14px;
  text-transform: uppercase;
}

.action-buttons .btn {
  margin: 0 2px;
  width: 32px;
  height: 32px;
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.action-buttons .btn:hover {
  transform: translateY(-2px) scale(1.1);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Add hover effects to table rows
  const tableRows = document.querySelectorAll('tbody tr');
  tableRows.forEach(row => {
    row.addEventListener('mouseenter', function() {
      this.style.transform = 'scale(1.01)';
    });
    
    row.addEventListener('mouseleave', function() {
      this.style.transform = 'scale(1)';
    });
  });
  
  // Add click animation to action buttons
  const actionButtons = document.querySelectorAll('.action-buttons .btn');
  actionButtons.forEach(btn => {
    btn.addEventListener('click', function(e) {
      this.style.transform = 'scale(0.95)';
      setTimeout(() => {
        this.style.transform = '';
      }, 150);
    });
  });
});
</script>